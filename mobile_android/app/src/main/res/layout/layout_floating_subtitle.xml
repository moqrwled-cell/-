<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_overlay"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- شريط السحب والأزرار -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="مترجم الفيديو المباشر ⚡"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="إغلاق" />
    </RelativeLayout>

    <!-- النص الإنجليزي الأصلي -->
    <TextView
        android:id="@+id/tvEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:visibility="visible" />

    <!-- الترجمة العربية الرئيسية (أصفر واضح دائماً) -->
    <TextView
        android:id="@+id/tvArabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:shadowColor="#FF000000"
        android:shadowDx="1.5"
        android:shadowDy="1.5"
        android:shadowRadius="3"
        android:text="جاري الاستماع وترجمة الفيديو..."
        android:textColor="#FFEB3B"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
