<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121216"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="مترجم الشاشة الفوري ⚡"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="التقاط صوت النظام الداخلي الرقمي - يعمل حتى لو كان الصوت مكتوماً تماماً!"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- بطاقة الأذونات المطلوبة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1E2028"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خطوات التفعيل:"
                android:textColor="#FFEB3B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="⚠️ 1. اضغط لمنح إذن الظهور فوق التطبيقات"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnMicPerm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="⚠️ 2. اضغط لمنح إذن تسجيل الصوت"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- بطاقة التشغيل الرئيسية -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E2028"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#2962FF"
                android:text="▶️ بدء الترجمة الداخلية (حتى مع كتم الصوت)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#D32F2F"
                android:text="⏹️ إيقاف شريط الترجمة"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="الحالة: متوقف"
                android:textColor="#00E676"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbBilingual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="عرض النص الإنجليزي بجانب الترجمة العربية"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- معلومات الميزة الخارقة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E2028"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟 كيف يترجم والصوت مكتوم؟"
                android:textColor="#FFEB3B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:text="• التطبيق يستخدم ميزة التقاط الصوت الرقمي الداخلي (Audio Playback Capture) مباشرة من بطاقة الصوت داخل الهاتف.\n• هذا يعني أنه يسجل الصوت الرقمي النقي من يوتيوب وتيك توك حتى لو كانت سماعات الهاتف موطية على الصفر تماماً.\n• الصوت الرقمي نقي 100% وبدون ضوضاء، مما يجعل الذكاء الاصطناعي يجلب كل الكلمات بدقة 99% وبسرعة خارقة!"
                android:textColor="#D0D0D0"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
