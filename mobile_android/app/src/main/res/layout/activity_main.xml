<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121216"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:text="مترجم الشاشة الفوري ⚡"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="شريط مدمج على قد الكلام - لا يحجب الفيديو أبداً!"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- بطاقة الأذونات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E2028"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خطوات التفعيل:"
                android:textColor="#FFEB3B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="⚠️ 1. اضغط لمنح إذن الظهور فوق التطبيقات"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMicPerm"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:text="⚠️ 2. اضغط لمنح إذن تسجيل الصوت"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- بطاقة التشغيل الرئيسية -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E2028"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#2962FF"
                android:text="▶️ إظهار شريط الترجمة وبدء الاستماع"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#D32F2F"
                android:text="⏹️ إيقاف شريط الترجمة"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="الحالة: متوقف"
                android:textColor="#00E676"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbBilingual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="عرض النص الإنجليزي بجانب الترجمة العربية"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- اختصارات التحكم السريعة أثناء مشاهدة الفيديو -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E2028"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ ميزات التحكم أثناء مشاهدة الفيديو:"
                android:textColor="#FFEB3B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:text="• عقد الكلام تماماً: حجم الشريط يصغر ويكبر تلقائياً حسب طول الجملة ولا يغطي شاشتك.\n• سحب حر: المس الشريط وحركه إلى أي مكان في الشاشة لتشاهد الفيديو براحة.\n• انقر نقراً مزدوجاً (Double Tap): لتغيير حجم خط الترجمة فوراً (صغير / متوسط / كبير).\n• اضغط ضغطاً مطولاً (Long Press): لتغيير شفافية الشريط لرؤية الفيديو بوضوح من خلاله!"
                android:textColor="#D0D0D0"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
